# ===== LLM（OpenAI 兼容接口 / Chat Completions）=====
# 豆包方舟示例： https://ark.cn-beijing.volces.com/api/v3
# DeepSeek 示例： https://api.deepseek.com/v1
# 本地 vLLM/Ollama 示例： http://localhost:8000/v1
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=sk-your-key
LLM_MODEL=your-chat-model
LLM_TEMPERATURE=0.3

# ===== Embedding（OpenAI 兼容接口 / Embeddings）=====
# 注意：Embedding 模型维度一旦写入 Milvus 集合就固定，更换不同维度模型需换集合名或删集合重建
# 豆包方舟可用 doubao-embedding 系列；硅基流动等第三方平台也提供 BGE 系列 OpenAI 兼容接口
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_API_KEY=sk-your-key
EMBEDDING_MODEL=your-embedding-model

# ===== Milvus =====
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=kb_chunks

# ===== 切片与检索 =====
CHUNK_SIZE=500
CHUNK_OVERLAP=80
RETRIEVAL_K=6
